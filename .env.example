# ---- Primary (recommended for open-source) ----
# Plain Postgres. Works with Docker (`docker compose up -d`), Neon, RDS, Supabase pooling, etc.
# Docker compose above exposes: postgresql://leadradar:leadradar@localhost:5433/leadradar
DATABASE_URL=postgresql://leadradar:leadradar@localhost:5433/leadradar

# ---- Google (required for discovery/enrichment/360) ----
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Supabase (OPTIONAL) ----
# Only needed if you want Supabase realtime + Supabase-hosted DB via REST.
# If DATABASE_URL is set, the server uses plain PG and Supabase is skipped.
# The client enables realtime only when these are present; otherwise it polls /api/db/*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never NEXT_PUBLIC_): required only for service-role flows, not used by default
# SUPABASE_SERVICE_ROLE_KEY=
